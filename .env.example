# Copie para .env e troque as senhas: cp .env.example .env
# O mesmo arquivo é lido pelo Docker Compose e pelo Spring Boot.

# PostgreSQL (admin: usado só pelos scripts de init e para DDL/EXPLAIN manuais)
POSTGRES_DB=pedidos
POSTGRES_ADMIN_USER=pedidos_admin
POSTGRES_ADMIN_PASSWORD=troque-esta-senha
# Porta no host; mude se já houver um PostgreSQL local na 5432
POSTGRES_PORT=5433

# Usuário da aplicação (somente SELECT/INSERT/UPDATE/DELETE)
APP_DB_USER=pedidos_app
APP_DB_PASSWORD=troque-esta-senha

# Redis
REDIS_PASSWORD=troque-esta-senha
REDIS_PORT=6379

# Aplicação
# TTL do cache de produtos (catálogo de preços: volatilidade média, 1–5 min na tabela da aula)
CACHE_TTL_PRODUTOS=5m
DB_POOL_SIZE=10
# debug = mostra o SQL gerado (experimentos de consulta); info = sem SQL (testes de carga)
SQL_LOG_LEVEL=info
